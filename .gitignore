# find an interpreter with ultralytics without any environment variable.
/.venv

# Scratch
.temp/
__*

# Yolo models
*.pt

# Training: raw/ (photos and your labels) is the source and is kept; the rest is
# generated.
/train/dataset/
/train/runs/
/train/.ultralytics/
/train/.cache/
/train/scripts/__pycache__/
/train/raw/
